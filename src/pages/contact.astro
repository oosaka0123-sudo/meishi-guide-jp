---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import RegistrationMark from '../components/svg/RegistrationMark.astro';
const title='お問い合わせ'; const description='名刺の見本帳へのお問い合わせ。';
---
<BaseLayout {title} {description} path="/contact/"><PageHero index="10" total="10" kicker="CONTACT" title="分からないところを、残さない。" lede="誤りの指摘、掲載内容へのご意見、制作に関するお問い合わせはこちらから。"><Fragment slot="figure"><RegistrationMark /></Fragment></PageHero><section class="section"><div class="wrap contact-wrap"><form aria-label="お問い合わせフォーム" action="#" method="post"><label>お名前<input name="name" autocomplete="name" required /></label><label>メールアドレス<input type="email" name="email" autocomplete="email" required /></label><label>お問い合わせ内容<textarea name="message" rows="7" required></textarea></label><button class="btn" type="submit">送信する <span class="btn-arrow">→</span></button><p class="form-note">※ 現在は公開前のため送信機能は未接続です。公開時に送信先を設定します。</p></form></div></section></BaseLayout><style>.contact-wrap{max-width:44rem}form{display:grid;gap:1.4rem}label{display:grid;gap:.45rem;font-weight:700}input,textarea{width:100%;border:1px solid var(--line-strong);background:rgba(255,255,255,.35);padding:.9rem 1rem;font:inherit;color:var(--ink)}textarea{resize:vertical}.form-note{font-size:.85rem;color:var(--ink-muted)}</style>
