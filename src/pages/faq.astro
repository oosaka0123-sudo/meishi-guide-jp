---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import RegistrationMark from '../components/svg/RegistrationMark.astro'; import NextStep from '../components/NextStep.astro';
const title='名刺づくり FAQ'; const description='名刺のサイズ、紙、文字、QRコード、印刷枚数、入稿など初心者のよくある疑問に回答。';
const qs=[['名刺の標準サイズは？','日本では91×55mmの4号名刺が最も一般的です。'],['文字は何ptが安全？','用途や書体によりますが、連絡先などは6〜9pt程度を基準に、実寸で読めるか確認します。'],['QRコードはどこに置く？','周囲に余白を取り、他の文字と干渉しない面に配置します。印刷後の読み取りテストは必須です。'],['何枚から発注すべき？','初回は少部数で色・紙厚・裁断を確認し、問題なければ増刷する方法が安全です。']];
---
<BaseLayout {title} {description} path="/faq/"><PageHero index="07" kicker="FAQ / QUICK ANSWERS" title="迷ったところだけ、すぐ答える。" lede="初めての名刺づくりで止まりやすい疑問を、判断しやすい短い答えにまとめました。"><Fragment slot="figure"><RegistrationMark /></Fragment></PageHero><section class="section"><div class="wrap faq-list">{qs.map(([q,a],i)=><details open={i===0}><summary><span>{String(i+1).padStart(2,'0')}</span>{q}</summary><p>{a}</p></details>)}</div></section><NextStep href="/about/" label="このサイトの考え方を見る" /></BaseLayout><style>.faq-list{max-width:60rem}.faq-list details{border-top:1px solid var(--line-strong);padding:1.2rem 0}.faq-list details:last-child{border-bottom:1px solid var(--line-strong)}summary{cursor:pointer;font-family:var(--font-display);font-size:clamp(1.2rem,2.5vw,1.6rem);display:flex;gap:1rem}summary span{font-family:var(--font-mono);font-size:.75rem;color:var(--vermilion)}details p{padding:1rem 0 0 2.6rem;max-width:44rem;color:var(--ink-muted)}</style>
