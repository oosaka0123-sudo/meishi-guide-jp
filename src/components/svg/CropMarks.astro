---
// Decorative print-style crop marks placed at the four corners of any
// ancestor with class "crop-frame". Purely presentational.
---
<span class="crop-mark crop-mark--tl" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="22" height="22"><line x1="9" y1="0" x2="9" y2="9" stroke="currentColor" stroke-width="1"/><line x1="0" y1="9" x2="9" y2="9" stroke="currentColor" stroke-width="1"/></svg>
</span>
<span class="crop-mark crop-mark--tr" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="22" height="22"><line x1="9" y1="0" x2="9" y2="9" stroke="currentColor" stroke-width="1"/><line x1="0" y1="9" x2="9" y2="9" stroke="currentColor" stroke-width="1"/></svg>
</span>
<span class="crop-mark crop-mark--bl" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="22" height="22"><line x1="9" y1="0" x2="9" y2="9" stroke="currentColor" stroke-width="1"/><line x1="0" y1="9" x2="9" y2="9" stroke="currentColor" stroke-width="1"/></svg>
</span>
<span class="crop-mark crop-mark--br" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="22" height="22"><line x1="9" y1="0" x2="9" y2="9" stroke="currentColor" stroke-width="1"/><line x1="0" y1="9" x2="9" y2="9" stroke="currentColor" stroke-width="1"/></svg>
</span>
