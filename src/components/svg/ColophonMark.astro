---
// Editorial colophon-style mark (a printed book's 奥付) used on /about/.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<figure class={`colophon ${className}`}>
  <svg viewBox="0 0 220 220" role="img" aria-labelledby="colTitle colDesc" width="100%">
    <title id="colTitle">運営者情報を示す奥付風のマーク</title>
    <desc id="colDesc">同心円と十字の見当ガイドに「発行」の文字を添えた、本の奥付をイメージした図。</desc>
    <circle cx="110" cy="110" r="86" fill="none" stroke="var(--ink, #1d1a17)" stroke-width="1.2" />
    <circle cx="110" cy="110" r="60" fill="none" stroke="var(--line-strong, rgba(29,26,23,.4))" stroke-width="0.8" stroke-dasharray="2 3" />
    <line x1="110" y1="10" x2="110" y2="46" stroke="var(--vermilion, #c33e1f)" stroke-width="1.2" />
    <line x1="110" y1="174" x2="110" y2="210" stroke="var(--vermilion, #c33e1f)" stroke-width="1.2" />
    <line x1="10" y1="110" x2="46" y2="110" stroke="var(--vermilion, #c33e1f)" stroke-width="1.2" />
    <line x1="174" y1="110" x2="210" y2="110" stroke="var(--vermilion, #c33e1f)" stroke-width="1.2" />
    <text x="110" y="104" text-anchor="middle" font-size="20" font-family="var(--font-display, serif)" fill="var(--ink, #1d1a17)">発行</text>
    <text x="110" y="128" text-anchor="middle" font-size="9.5" font-family="var(--font-mono, monospace)" letter-spacing="0.08em" fill="var(--ink-muted, #5c564d)">MEISHI GUIDE JP</text>
  </svg>
</figure>

<style>
  .colophon {
    margin: 0;
    padding: clamp(1rem, 3vw, 1.75rem);
    background: var(--paper-deep);
    border: 1px solid var(--line-strong);
    max-width: 260px;
  }
</style>
