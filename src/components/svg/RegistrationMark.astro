---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = "" } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="16" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="1" />
  <line x1="16" y1="0" x2="16" y2="32" stroke="currentColor" stroke-width="1" />
  <line x1="0" y1="16" x2="32" y2="16" stroke="currentColor" stroke-width="1" />
  <circle cx="16" cy="16" r="2.2" fill="currentColor" />
</svg>
