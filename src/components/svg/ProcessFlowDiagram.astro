---
// Four-step production flow used on /how-to/.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const steps = [
  { n: "01", label: "情報を決める", note: "名前・肩書・連絡先を整理" },
  { n: "02", label: "作り方を選ぶ", note: "自作／印刷会社／デザイナー" },
  { n: "03", label: "デザイン・入稿", note: "サイズ・塗り足しを確認" },
  { n: "04", label: "校正・発注", note: "色と文字を最終チェック" },
];
---
<figure class={`flow-diagram ${className}`}>
  <svg viewBox="0 0 320 130" role="img" aria-labelledby="pfTitle pfDesc" width="100%">
    <title id="pfTitle">名刺ができるまでの4ステップ</title>
    <desc id="pfDesc">情報整理、作り方の選択、デザインと入稿、校正と発注という4段階の流れを示す図。</desc>
    <line x1="30" y1="34" x2="290" y2="34" stroke="var(--line-strong, rgba(29,26,23,.4))" stroke-width="1" />
    {steps.map((s, i) => {
      const x = 30 + i * 86.6;
      return (
        <g>
          <circle cx={x} cy="34" r="5" fill="var(--paper, #f7f3ec)" stroke="var(--vermilion, #c33e1f)" stroke-width="1.6" />
          <text x={x} y="14" text-anchor="middle" font-size="10" font-family="var(--font-mono, monospace)" fill="var(--ink-faint, #948c7d)">{s.n}</text>
          <text x={x} y="62" text-anchor="middle" font-size="12" font-family="var(--font-display, serif)" fill="var(--ink, #1d1a17)">{s.label}</text>
          <foreignObject x={x - 55} y="70" width="110" height="50">
            <p xmlns="http://www.w3.org/1999/xhtml" style="margin:0;font-size:10.5px;line-height:1.5;text-align:center;color:var(--ink-muted,#5c564d);font-family:var(--font-body,sans-serif);">{s.note}</p>
          </foreignObject>
        </g>
      );
    })}
  </svg>
</figure>

<style>
  .flow-diagram {
    margin: 0;
    padding: clamp(1rem, 3vw, 1.75rem);
    background: var(--paper-deep);
    border: 1px solid var(--line-strong);
  }
</style>
